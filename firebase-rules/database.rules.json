{
  "rules": {
    ".read": false,
    ".write": false,

    "presence": {
      "$listingId": {
        // Anyone (signed-in or anonymous) may read the viewer list to
        // compute the live count — but the payload only ever contains
        // sessionId, lastSeen, active, never a user identity.
        ".read": true,

        "$sessionId": {
          // A session may only write to its OWN sessionId node. There is
          // no server-side auth binding for anonymous sessions, so this
          // relies on sessionId being an unguessable random string
          // generated client-side (see usePresence.ts) — it is not a
          // security boundary against a malicious client, only protects
          // against accidental cross-session overwrites. Do not store
          // anything sensitive here.
          ".write": true,
          ".validate": "newData.hasChildren(['lastSeen', 'active'])",

          "lastSeen": {
            ".validate": "newData.val() === now"
          },
          "active": {
            ".validate": "newData.isBoolean()"
          }
        }
      }
    }
  }
}
